<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        TEMA UTAMA APLIKASI (MODE MALAM)
    -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Warna Utama -->
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorPrimaryVariant">@color/blue_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Warna Sekunder -->
        <item name="colorSecondary">@color/blue_gradient_start</item>
        <item name="colorSecondaryVariant">@color/blue_primary</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Warna Latar Belakang (Gelap) -->
        <item name="android:colorBackground">@color/text_primary</item>
        <item name="colorSurface">@color/text_primary</item>

        <!-- Warna Status Bar -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/black</item>

        <!-- Style Input Box -->
        <item name="textInputStyle">@style/AppTheme.TextInputLayout</item>
    </style>

    <!-- Style kustom untuk Input Box (sudah didefinisikan di themes.xml utama) -->
    <!-- <style name="AppTheme.TextInputLayout" ... /> -->
</resources>