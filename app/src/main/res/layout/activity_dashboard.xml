<?xml version="1.0" encoding="utf-8"?>
<!--
    ROOT: SwipeRefreshLayout
    Ini membungkus seluruh layar agar bisa ditarik ke bawah untuk refresh.
-->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.dashboard.DashboardActivity">

    <!-- KONTEN DASHBOARD (ConstraintLayout) dipindahkan ke dalam sini -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:padding="16dp">

        <!-- 1. HEADER -->
        <ImageView
            android:id="@+id/imageAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/ic_person_profile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/blue_primary" />

        <TextView
            android:id="@+id/textViewSelamatDatang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Memuat..."
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/imageAvatar"
            app:layout_constraintTop_toTopOf="@id/imageAvatar" />

        <TextView
            android:id="@+id/textViewGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selamat Datang!"
            android:textColor="@color/text_secondary"
            app:layout_constraintStart_toStartOf="@id/textViewSelamatDatang"
            app:layout_constraintTop_toBottomOf="@id/textViewSelamatDatang" />

        <!-- 2. KARTU SALDO -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSaldo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:layout_constraintTop_toBottomOf="@id/imageAvatar">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/gradient_saldo_card"
                android:padding="20dp">

                <TextView
                    android:id="@+id/textViewSaldoLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Saldo Anda Saat Ini:"
                    android:textColor="@color/white"
                    android:alpha="0.8"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/textViewSaldo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Rp 0"
                    android:textColor="@color/white"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/buttonToggleSaldo"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/textViewSaldoLabel" />

                <ImageButton
                    android:id="@+id/buttonToggleSaldo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_visibility"
                    app:layout_constraintBottom_toBottomOf="@id/textViewSaldo"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/textViewSaldo"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/textViewNoRekening"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="No. Rek: ..."
                    android:textColor="@color/white"
                    android:alpha="0.9"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/textViewSaldo" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. MENU GRID -->
        <LinearLayout
            android:id="@+id/menuGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginStart="16dp"
            android:weightSum="4"
            app:layout_constraintTop_toBottomOf="@id/cardSaldo">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSetor"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Setor"
                android:textColor="@color/text_primary"
                app:icon="@drawable/ic_setor"
                app:iconTint="@color/blue_primary"
                app:iconGravity="textTop"
                app:iconPadding="8dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonTarik"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tarik"
                android:textColor="@color/text_primary"
                app:icon="@drawable/ic_tarik"
                app:iconTint="@color/blue_primary"
                app:iconGravity="textTop"
                app:iconPadding="8dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRiwayat"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Riwayat"
                android:textColor="@color/text_primary"
                app:icon="@drawable/ic_riwayat"
                app:iconTint="@color/blue_primary"
                app:iconGravity="textTop"
                app:iconPadding="8dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonLaporan"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Laporan"
                android:textColor="@color/text_primary"
                app:icon="@drawable/ic_laporan"
                app:iconTint="@color/blue_primary"
                app:iconGravity="textTop"
                app:iconPadding="8dp" />
        </LinearLayout>

        <!-- 4. GARIS PEMISAH -->
        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@color/divider_light"
            app:layout_constraintTop_toBottomOf="@id/menuGrid" />

        <!-- 5. TRANSAKSI TERBARU -->
        <TextView
            android:id="@+id/textViewTransaksiLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="16dp"
            android:text="Transaksi Terbaru"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerRecentTransactions"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textViewTransaksiLabel"
            tools:listitem="@layout/item_transaksi"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/textNoTransaksi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Memuat riwayat..."
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textViewTransaksiLabel"
            app:layout_constraintVertical_bias="0.2" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>