<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.tarik.TarikActivity">

    <!-- 1. HEADER BESAR (Menampilkan Saldo) -->
    <View
        android:id="@+id/headerBackground"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:background="@color/blue_primary"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarTarik"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/white"
        app:title="Tarik Tunai"
        app:titleTextColor="@color/white" />

    <!-- Info Saldo -->
    <TextView
        android:id="@+id/textSumberDana"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:text="Sumber Dana (Tabungan)"
        android:textColor="@color/white"
        android:alpha="0.8"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarTarik" />

    <TextView
        android:id="@+id/textSaldoSaatIni"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        android:text="Rp ..."
        android:textColor="@color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textSumberDana" />

    <!-- 2. KARTU INPUT UTAMA -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/textSaldoSaatIni">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nominal Penarikan"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_gravity="center_horizontal"/>

            <!-- Input Uang BESAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp"/>

                <EditText
                    android:id="@+id/editTextJumlahTarik"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="0"
                    android:inputType="number"
                    android:minWidth="100dp"
                    android:textColor="@color/blue_primary_dark"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="40sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_light"
                android:layout_marginVertical="16dp"/>

            <!-- Pilihan Cepat (Chips) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pilihan Cepat"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:rowCount="2">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip50k"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:text="50rb"
                    android:textAlignment="center"
                    app:chipBackgroundColor="@color/blue_accent_light"
                    android:textColor="@color/blue_primary"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip100k"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:text="100rb"
                    android:textAlignment="center"
                    app:chipBackgroundColor="@color/blue_accent_light"
                    android:textColor="@color/blue_primary"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip200k"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:text="200rb"
                    android:textAlignment="center"
                    app:chipBackgroundColor="@color/blue_accent_light"
                    android:textColor="@color/blue_primary"/>
            </GridLayout>

            <!-- Input Keterangan -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Catatan / Keperluan"
                app:boxStrokeColor="@color/blue_primary"
                app:hintTextColor="@color/blue_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextKeterangan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:textColor="@color/text_primary"/>
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Tombol Konfirmasi -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonKonfirmasiTarik"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_margin="24dp"
        android:text="Tarik Tunai Sekarang"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="@color/blue_primary"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>